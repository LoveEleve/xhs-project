{
  "title": "JVM 监控",
  "uid": "myxhs-jvm",
  "tags": [
    "myxhs",
    "jvm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "allValue": null,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": "Prometheus",
        "definition": "label_values(jvm_memory_used_bytes, application)",
        "description": null,
        "error": null,
        "hide": 0,
        "includeAll": true,
        "label": "Application",
        "multi": true,
        "name": "application",
        "options": [],
        "query": {
          "query": "label_values(jvm_memory_used_bytes, application)",
          "refId": "Prometheus-application-Variable-Query"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "tagValuesQuery": "",
        "tagsQuery": "",
        "type": "query",
        "useTags": false
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "title": "堆内存使用（分代）",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\",id=~\"G1 Eden Space|G1 Survivor Space|G1 Old Gen\",application=~\"$application\"}",
          "legendFormat": "{{id}}",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_committed_bytes{area=\"heap\",application=~\"$application\"}",
          "legendFormat": "committed",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "title": "非堆内存使用（Metaspace/CodeCache）",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"nonheap\",application=~\"$application\"}",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "title": "GC 频率（次/分钟）",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_count{application=~\"$application\"}[5m]) * 60",
          "legendFormat": "{{action}} - {{cause}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "title": "GC 耗时（总/最大）",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=~\"$application\"}[5m])",
          "legendFormat": "GC 耗时速率 {{cause}}",
          "refId": "A"
        },
        {
          "expr": "jvm_gc_pause_seconds_max{application=~\"$application\"}",
          "legendFormat": "最大耗时 {{cause}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "title": "GC 开销百分比",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_gc_overhead_percent{application=~\"$application\"}",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "title": "晋升到 Old 区字节速率",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(jvm_gc_memory_promoted_bytes_total{application=~\"$application\"}[5m])",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "title": "JVM 线程数（live/daemon/peak）",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=~\"$application\"}",
          "legendFormat": "live {{application}}",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{application=~\"$application\"}",
          "legendFormat": "daemon {{application}}",
          "refId": "B"
        },
        {
          "expr": "jvm_threads_peak_threads{application=~\"$application\"}",
          "legendFormat": "peak {{application}}",
          "refId": "C"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "title": "线程状态分布",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_threads_states_threads{application=~\"$application\"}",
          "legendFormat": "{{state}} {{application}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "title": "CPU 使用率（process/system）",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "process_cpu_usage{application=~\"$application\"}",
          "legendFormat": "process {{application}}",
          "refId": "A"
        },
        {
          "expr": "system_cpu_usage{application=~\"$application\"}",
          "legendFormat": "system {{application}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "title": "类加载数（loaded/unloaded 速率）",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_classes_loaded_classes{application=~\"$application\"}",
          "legendFormat": "loaded {{application}}",
          "refId": "A"
        },
        {
          "expr": "rate(jvm_classes_unloaded_classes_total{application=~\"$application\"}[5m]) * 60",
          "legendFormat": "unloaded/min {{application}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "title": "直接缓冲区（内存/数量）",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_buffer_memory_used_bytes{application=~\"$application\"}",
          "legendFormat": "memory {{application}}",
          "refId": "A"
        },
        {
          "expr": "jvm_buffer_count_buffers{application=~\"$application\"}",
          "legendFormat": "count {{application}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "title": "JIT 编译时间（累计）",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_compilation_time_ms_total{application=~\"$application\"}",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    }
  ]
}