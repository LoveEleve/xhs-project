{
 "uid": "myxhs-redis",
 "title": "Redis 监控",
 "schemaVersion": 38,
 "panels": [
  {
   "type": "timeseries",
   "title": "内存使用",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "targets": [
    {
     "expr": "redis_memory_used_bytes",
     "legendFormat": "{{__name__}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "drawStyle": "line"
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "客户端连接",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "targets": [
    {
     "expr": "redis_connected_clients",
     "legendFormat": "{{__name__}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line"
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list"
    }
   }
  },
