{
 "uid": "myxhs-node",
 "title": "主机监控 (Node Exporter)",
 "schemaVersion": 38,
 "panels": [
  {
   "type": "timeseries",
   "title": "CPU 使用率",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "targets": [
    {
     "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 0
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list"
    }
   }
  },
  {
   "type": "timeseries",
