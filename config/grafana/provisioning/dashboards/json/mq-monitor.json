{
 "uid": "myxhs-mq",
 "title": "RocketMQ 监控",
 "schemaVersion": 38,
 "panels": [
  {
   "type": "timeseries",
   "title": "DLQ 死信积压",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "targets": [
    {
     "expr": "rocketmq_dlq_backlog",
     "legendFormat": "consumer_group"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line"
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "MQ 消费速率",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "targets": [
    {
     "expr": "sum(rate(mq_consume_total[5m])) by (topic)",
     "legendFormat": "topic"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "drawStyle": "line"
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "DLQ 消息累计",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
