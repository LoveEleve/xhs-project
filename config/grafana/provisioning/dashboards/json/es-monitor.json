    }
   },
   "options": {
    "legend": {
     "displayMode": "list"
    }
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 40
   }
  }
 ],
 "templating": {
  "list": []
 },
 "time": {
