   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "drawStyle": "line"
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list"
    }
   }
  },
  {
   "type": "timeseries",
