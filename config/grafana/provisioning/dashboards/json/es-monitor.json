   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "targets": [
    {
     "expr": "sum(elasticsearch_indices_docs_deleted)",
     "legendFormat": "{{__name__}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line"
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "数据盘可用空间",
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "targets": [
    {
     "expr": "elasticsearch_filesystem_data_available_bytes",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 0
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list"
    }
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   }
  },
  {
   "type": "timeseries",
   "title": "JVM 堆内存",
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "targets": [
    {
     "expr": "elasticsearch_jvm_memory_used_bytes",
