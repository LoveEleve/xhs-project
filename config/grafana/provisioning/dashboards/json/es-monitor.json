   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "targets": [
    {
     "expr": "sum(elasticsearch_indices_docs)",
     "legendFormat": "{{__name__}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line"
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "索引数量",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "targets": [
    {
     "expr": "count(elasticsearch_indices_docs)",
     "legendFormat": "{{__name__}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line"
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list"
    }
   }
  },
  {
