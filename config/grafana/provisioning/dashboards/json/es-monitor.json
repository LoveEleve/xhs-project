     "custom": {
      "drawStyle": "line",
      "fillOpacity": 0
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list"
    }
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 32
   }
  },
  {
   "type": "timeseries",
   "title": "查询延迟",
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "targets": [
    {
     "expr": "rate(elasticsearch_indices_search_query_time_seconds[5m])",
